################################################################################
# TRADING BOT CONFIGURATION
# Copy this file to .env and fill in all API keys
# Never commit .env to version control
# See README.md for detailed setup instructions for each service
################################################################################

# ============================================================================
# AI ANALYSIS ENGINES
# ============================================================================

# Groq API (FREE TIER)
# - URL: https://console.groq.com
# - Steps: Sign up → API Keys → Create New API Key
# - Model: llama-3.3-70b-versatile (free, fast inference)
# - Used for: Fast first-pass sentiment analysis on financial news
GROQ_API_KEY=

# Google Gemini API (FREE TIER)
# - URL: https://aistudio.google.com
# - Steps: Sign up with Google account → Get API Key → Create
# - Model: gemini-1.5-flash (free tier: 15 req/min, 1M tokens/day)
# - Used for: Deep contextual market analysis with full context
GEMINI_API_KEY=

# ============================================================================
# EXCHANGE APIs - PRIMARY (BYBIT)
# ============================================================================

# Bybit API Keys (TESTNET & LIVE)
# - Testnet: https://testnet.bybit.com (register separately from live)
#   URL: https://testnet.bybit.com → Account → API Management
# - Live: https://bybit.com → Account → API Management
# - Used for: Live/paper trading, market data, real-time prices
# - Testnet is REQUIRED for testing. Never use live keys in development.
BYBIT_API_KEY=
BYBIT_SECRET=
BYBIT_TESTNET=true      # Set to false ONLY after 4+ weeks of paper testing

# ============================================================================
# NEWS & SENTIMENT DATA SOURCES
# ============================================================================

# NewsAPI (FREE TIER)
# - URL: https://newsapi.org/register
# - Steps: Sign up → API Key → copy it
# - Free tier: 100 requests/day
# - Used for: Financial news headlines for sentiment analysis
NEWSAPI_KEY=

# CryptoCompare API (FREE TIER)
# - URL: https://min-api.cryptocompare.com
# - Steps: Sign up → Settings → API Keys → Create new key
# - Free tier: 100k calls/month
# - Used for: Crypto-specific news with community sentiment votes
CRYPTOCOMPARE_API_KEY=

# ============================================================================
# TRADING BOT PARAMETERS
# ============================================================================

# Exchange Configuration
EXCHANGE=bybit
SYMBOLS=BTC/USDT,ETH/USDT          # Comma-separated, no spaces

# Trading Modes
PAPER_TRADING=true                  # true = simulation, false = REAL MONEY
INITIAL_CASH=10000.0                # Starting balance for paper trading

# Timeframes
PRIMARY_TIMEFRAME=1h                # Main timeframe for signals
ENTRY_TIMEFRAME=15m                 # Fine-grained entry confirmation
TREND_TIMEFRAME=4h                  # Macro trend context

# AI Model Weighting (must sum to 1.0)
TECHNICAL_WEIGHT=0.40               # Technical indicators
SENTIMENT_WEIGHT=0.40               # AI sentiment analysis
MARKET_SENTIMENT_WEIGHT=0.20        # Fear/Greed, L/S ratio, funding

# Technical Analysis Parameters
EMA_PERIODS=9,20,50,200             # Exponential moving averages
MACD_FAST=12
MACD_SLOW=26
MACD_SIGNAL=9
RSI_PERIOD=14
RSI_OVERSOLD=35                     # RSI < 35 = potential buy
RSI_OVERBOUGHT=70                   # RSI > 70 = potential sell
ATR_PERIOD=14                       # Average True Range for volatility
ADX_TREND_THRESHOLD=25              # ADX > 25 = trending

# Risk Management
RISK_PER_TRADE=0.02                 # 2% risk per trade
DAILY_LOSS_LIMIT=0.05               # Stop if down 5% in a day
WEEKLY_LOSS_LIMIT=0.10              # Stop if down 10% in a week
MAX_DRAWDOWN=0.15                   # Stop if account drops 15%
MAX_POSITIONS=3                     # Max open positions
MIN_REWARD_RISK=2.5                 # Minimum 2.5:1 reward/risk ratio

# Signal Generation
# Scoring: 80-100 = STRONG_BUY, 65-79 = BUY, 40-64 = HOLD,
#          25-39 = SELL, 0-24 = STRONG_SELL
SENTIMENT_CACHE_MINUTES=10          # Cache sentiment scores

# AI Models
GROQ_MODEL=llama-3.3-70b-versatile  # Groq's fastest model
GEMINI_MODEL=gemini-1.5-flash       # Gemini's fastest model

# Bot Scheduling
BOT_PAUSED=false                    # true = disable trading
LOOP_INTERVAL_SECONDS=900           # Run trading loop every 15min
PREMARKET_TIME_WAT=06:00            # Morning briefing time
EOD_REVIEW_TIME_WAT=23:00           # End of day analysis time
INTRADAY_UPDATE_HOURS=2             # Update intelligence every 2h
PREMARKET_NEWS_WINDOW_DAYS=7        # Look back 7 days for patterns

# Position Management
MAX_ASSETS_TO_TRADE_DAILY=3         # Max 3 assets per day
HIGH_RISK_POSITION_MULTIPLIER=0.50  # 50% size on high risk
EXTREME_RISK_SKIP_TRADING=true      # Skip entirely on extreme risk

# Reporting
SAVE_DAILY_REPORTS=true             # Save briefings and EOD reports
TIMEZONE=Africa/Lagos               # WAT = West Africa Time (UTC+1)

################################################################################
# RECOMMENDED INITIAL SETUP
# ============================================================================
# 1. NEVER use live exchange keys in development
# 2. Always start with PAPER_TRADING=true and BYBIT_TESTNET=true
# 3. Get API keys in this order:
#    - Groq (fastest, takes 2 minutes)
#    - Gemini (takes 1 minute)
#    - Bybit testnet (takes 10 minutes)
#    - Others as needed
# 4. Test with paper trading for at least 4 weeks
# 5. Only then switch to PAPER_TRADING=false with real money
################################################################################
